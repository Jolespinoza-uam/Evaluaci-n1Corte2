<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.papeleriacampus.controller.ProductosController">
    <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
    <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Papelería Campus" />
    <Label text="Catálogo de productos" />
    <Label fx:id="lblSeleccion" text="Nuevo producto" />
    <GridPane hgap="14" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="80" />
            <ColumnConstraints hgrow="ALWAYS" prefWidth="300" />
            <ColumnConstraints minWidth="90" />
            <ColumnConstraints hgrow="ALWAYS" prefWidth="300" />
        </columnConstraints>
        <Label text="Código:" />
        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" />
        <Label text="Nombre:" GridPane.columnIndex="2" />
        <TextField fx:id="txtNombre" GridPane.columnIndex="3" />
        <Label text="Categoría:" GridPane.rowIndex="1" />
        <ComboBox fx:id="cmbCategoria" editable="false" maxWidth="Infinity" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Precio C$:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtPrecio" GridPane.columnIndex="3" GridPane.rowIndex="1" />
        <Label text="Stock:" GridPane.rowIndex="2" />
        <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>
    <HBox spacing="10">
        <Button onAction="#nuevoProducto" text="Nuevo / Limpiar formulario" />
        <Button onAction="#guardarProducto" text="Guardar" />
        <Button onAction="#actualizarProducto" text="Actualizar" />
        <Button onAction="#eliminarProducto" text="Eliminar" />
    </HBox>
    <Separator />
    <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Búsqueda y filtros" />
    <HBox alignment="CENTER_LEFT" spacing="12">
        <TextField fx:id="txtBusqueda" onAction="#buscarProductos" promptText="Nombre o código" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="cmbFiltroCategoria" editable="false" prefWidth="170" />
        <CheckBox fx:id="chkExistencias" text="Solo con existencias" />
    </HBox>
    <HBox spacing="10">
        <Button onAction="#buscarProductos" text="Buscar" />
        <Button onAction="#limpiarFiltros" text="Limpiar filtros" />
        <Button onAction="#recargarProductos" text="Recargar" />
    </HBox>
    <TableView fx:id="tblProductos" prefHeight="280" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="65" text="ID" />
            <TableColumn fx:id="colCodigo" prefWidth="115" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="325" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="170" text="Categoría" />
            <TableColumn fx:id="colPrecio" prefWidth="170" text="Precio C$" />
            <TableColumn fx:id="colStock" prefWidth="115" text="Stock" />
        </columns>
    </TableView>
    <Label fx:id="lblContador" text="Registros visibles: pendiente de consulta" />
</VBox>
